# Variables de entorno — host autoritativo (game/server/host.gd) y
# cliente. Copiar a .env o exportarlas en el shell; ninguna es
# obligatoria (los defaults sirven para LAN/self-host).

# --- host ---
# TLS nativo → wss:// (ambas o ninguna, archivos PEM)
#BELIBER_TLS_CERT=/path/fullchain.pem
#BELIBER_TLS_KEY=/path/privkey.pem

# Rutas de persistencia del ladder (tests las redirigen a %TEMP%)
#BELIBER_RATINGS=/path/beliber_ratings.json
#BELIBER_TOKENS=/path/beliber_idtokens.json

# --- cliente ---
# Saltar validación de cert para probar wss:// autofirmado
#BELIBER_TLS_INSECURE=1

# Rutas de estado local (aislamiento de tests)
#BELIBER_CFG=/path/beliber.cfg
#BELIBER_SAVE=/path/beliber_save.json
#BELIBER_EXPORT=/path/exports
